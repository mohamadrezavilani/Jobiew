# Production values belong ONLY in /etc/jobiew/jobiew.env (mode 640, owned root:jobiew).
# Never commit credentials, production database data, user reviews or media.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_VIA_python_-c
DJANGO_ALLOWED_HOSTS=jobiew.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://jobiew.example.com
DJANGO_TRUST_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=0
WI_DB_ENGINE=postgresql
WI_DB_NAME=jobiew
WI_DB_USER=jobiew_app
WI_DB_PASSWORD=REPLACE_ME
WI_DB_HOST=127.0.0.1
WI_DB_PORT=5432
JOBIEW_RUNTIME_DIR=/var/lib/jobiew
JOBIEW_STATIC_ROOT=/var/www/jobiew/static
JOBIEW_CRAWLER_PERMISSION_CONFIRMED=0
JOBIEW_CRAWL_MAX_ITEMS=50
JOBIEW_CRAWL_MAX_REQUESTS=90
JOBIEW_CRAWL_PAUSE_SECONDS=12

# These switches are independent and OFF by default.
JOBIEW_HOMEPAGE_PUBLIC_ENABLED=0
JOBIEW_DUAL6_PUBLICATION_ENABLED=0
JOBIEW_GPT6_APPROVED_PUBLICATION_ENABLED=0
# Private staging flags must never be set on a public host.
JOBIEW_CHECKPOINT_STAGING_ENABLED=0
JOBIEW_CHECKPOINT_IMPORT_STAGING_ENABLED=0

# Private six-axis backoffice on production HTTPS (staff only; opt-in).
JOBIEW_PRIVATE_CHECKPOINT_REVIEW_ENABLED=0
JOBIEW_PRIVATE_CHECKPOINT_IMPORT_ENABLED=0
JOBIEW_COMPANY_RELEASE_ONLY_ENABLED=0
JOBIEW_CHECKPOINT_PUBLIC_HOST=

# Optional private independent Claude six-axis comparison (paid; disabled by default).
# Configure via sudo python3 /opt/jobiew/scripts/enable_claude_six_v234.py --limit 20
# NEVER put a real Anthropic key in this example or in Git.
JOBIEW_CLAUDE_SIX_ENABLED=0
JOBIEW_CLAUDE_SIX_LIMIT=0
JOBIEW_CLAUDE_SIX_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
